// Prisma 7: la URL vive en prisma.config.ts (env DATABASE_URL)
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VersionAuthor {
  user
  agent
}

enum BranchStatus {
  active
  merged
  discarded
}

enum KnowledgeDocumentStatus {
  pending
  ready
  error
}

/// Libro o trabajo. Tabla: projects
model Project {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  chapters           Chapter[]
  knowledgeDocuments KnowledgeDocument[]

  @@map("projects")
}

/// PDF u otro origen; biblioteca de referencia por proyecto. Tabla: knowledge_documents
model KnowledgeDocument {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Título visible; editable, distinto del nombre de archivo
  title           String
  sourceFilename  String   @map("source_filename")
  status          KnowledgeDocumentStatus
  errorMessage    String?  @map("error_message") @db.Text
  activeForAgent  Boolean  @default(false) @map("active_for_agent")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  chunks          KnowledgeChunk[]

  @@index([projectId, status])
  @@index([projectId, activeForAgent])
  @@map("knowledge_documents")
}

/// Fragmento indexado. Embeddings en JSON (MVP; migrable a pgvector). Tabla: knowledge_chunks
model KnowledgeChunk {
  id         String            @id @default(uuid()) @db.Uuid
  documentId String            @map("document_id") @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int               @map("chunk_index")
  text       String            @db.Text
  /// Vector como array JSON de números (dimensión fija del modelo)
  embedding  Json
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([documentId, chunkIndex])
  @@map("knowledge_chunks")
}

/// Capítulo. Tabla: chapters
model Chapter {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  /// Título visible (p. ej. «El umbral»). Vacío = mostrar solo número de capítulo.
  title     String  @default("")


  /// Puntero a la versión "oficial" (main) del capítulo. @unique: una fila de Version como máximo.
  mainVersionId String?  @unique @map("main_version_id") @db.Uuid
  mainVersion   Version? @relation("ChapterMainVersion", fields: [mainVersionId], references: [id], onDelete: SetNull)

  branches Branch[]
  versions Version[]

  @@index([projectId, order])
  @@map("chapters")
}

/// Variante semántica (intención de cambio), no "rama Git" técnica. Tabla: branches
model Branch {
  id                   String   @id @default(uuid()) @db.Uuid
  chapterId            String   @map("chapter_id") @db.Uuid
  chapter              Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  slug                 String
  name                 String
  description          String?
  /// Versión de la que nace la intención (si aplica)
  createdFromVersionId String?  @map("created_from_version_id") @db.Uuid
  status               BranchStatus
  createdAt            DateTime @default(now()) @map("created_at")
  versions             Version[]

  @@unique([chapterId, slug])
  @@index([chapterId, status])
  @@map("branches")
}

/// Snapshot inmutable. Tabla: versions
model Version {
  id        String  @id @default(uuid()) @db.Uuid
  chapterId String  @map("chapter_id") @db.Uuid
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  /// Rama narrativa; la línea "main" usa la rama con slug "main"
  branchId  String? @map("branch_id") @db.Uuid
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  content         String
  parentVersionId String?  @map("parent_version_id") @db.Uuid
  /// mergeParents, styleShift, aiGenerated, etc.
  metadata        Json?    @map("metadata")
  createdBy       VersionAuthor @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")

  /// Capítulo cuyo main apunta a esta versión
  isMainForChapter Chapter? @relation("ChapterMainVersion")

  @@index([chapterId, createdAt])
  @@index([branchId, createdAt])
  @@map("versions")
}
