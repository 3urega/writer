// Prisma 7: la URL vive en prisma.config.ts (env DATABASE_URL)
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VersionAuthor {
  user
  agent
}

/// Libro o trabajo. Tabla: projects
model Project {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  chapters  Chapter[]

  @@map("projects")
}

/// Capítulo. Tabla: chapters
model Chapter {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  versions  Version[]

  @@index([projectId, order])
  @@map("chapters")
}

/// Snapshot inmutable del capítulo. Tabla: versions
model Version {
  id              String         @id @default(uuid()) @db.Uuid
  chapterId       String         @map("chapter_id") @db.Uuid
  chapter         Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  content         String
  parentVersionId String?        @map("parent_version_id") @db.Uuid
  createdBy       VersionAuthor  @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([chapterId, createdAt])
  @@map("versions")
}
